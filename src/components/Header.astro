---
import Search from "./react/Search";
import ThemeToggle from "./react/ThemeToggle";
import Sidebar from "./Sidebar.astro";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<header class="header" data-header>
  <div class="header__inner">
    <a href="/" class="brand" aria-label="Blume 中文文档首页">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3c.4 2.6-.9 4-2.2 5.3C8.2 10 6.6 11.6 6.6 14a5.4 5.4 0 0 0 10.8 0c0-1.5-.5-2.7-1.3-3.9" />
          <path d="M12 21a3 3 0 0 0 3-3c0-1.9-1.7-2.6-3-4.6-1.3 2-3 2.7-3 4.6a3 3 0 0 0 3 3Z" opacity=".55" />
        </svg>
      </span>
      <span class="brand__text">
        Blume
        <span class="brand__lang">中文文档</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="主导航">
      <a href="/docs" class="header__nav-link" data-active={pathname.startsWith("/docs")}>文档</a>
      <a href="/docs/quickstart" class="header__nav-link">快速开始</a>
      <a href="/docs/content/components" class="header__nav-link">组件</a>
      <a href="/docs/cli" class="header__nav-link">命令行</a>
      <a href="/docs/faq" class="header__nav-link">FAQ</a>
    </nav>

    <div class="header__tools">
      <div class="header__search">
        <Search client:load />
      </div>
      <a
        class="header__icon-btn"
        href="https://useblume.dev"
        target="_blank"
        rel="noreferrer noopener"
        aria-label="访问 Blume 英文官网"
        title="英文官网"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" />
          <path d="M1.75 8h12.5M8 1.75c1.6 1.8 2.5 4 2.5 6.25S9.6 12.45 8 14.25C6.4 12.45 5.5 10.25 5.5 8S6.4 3.55 8 1.75Z" />
        </svg>
      </a>
      <ThemeToggle client:load />
      <button type="button" class="header__icon-btn md:hidden" data-nav-toggle aria-label="打开导航" aria-expanded="false">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="drawer" data-drawer hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="文档导航">
    <div class="drawer__head">
      <span class="drawer__title">文档</span>
      <button type="button" class="header__icon-btn" data-drawer-close aria-label="关闭导航">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
          <path d="m5.5 5.5 9 9m0-9-9 9" />
        </svg>
      </button>
    </div>
    <div class="drawer__body">
      <Sidebar pathname={pathname} variant="mobile" />
    </div>
  </div>
</div>

<script>
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");

  function setDrawer(open: boolean) {
    if (!drawer) return;
    drawer.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => setDrawer(drawer?.hidden !== false));
  for (const el of document.querySelectorAll("[data-drawer-close]")) {
    el.addEventListener("click", () => setDrawer(false));
  }
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setDrawer(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 60;
    border-bottom: 1px solid var(--border);
    background-color: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.75rem;
    padding-inline: 1rem;
    max-width: 96rem;
    margin-inline: auto;
  }
  @media (width >= 48rem) {
    .header__inner {
      padding-inline: 2rem;
    }
  }
  @media (width >= 80rem) {
    .header__inner {
      padding-inline: 2.5rem;
    }
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--fg);
    font-weight: 680;
    letter-spacing: -0.015em;
    flex: none;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.5rem;
    background: linear-gradient(140deg, var(--color-brand-400), var(--color-brand-600));
    color: #fff;
    box-shadow: 0 2px 8px -2px color-mix(in oklab, var(--color-brand-500) 60%, transparent);
  }
  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand__lang {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }
  .header__nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (width >= 64rem) {
    .header__nav {
      display: flex;
    }
  }
  .header__nav-link {
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.84375rem;
    color: var(--fg-muted);
    text-decoration: none;
    transition:
      color 0.14s ease,
      background-color 0.14s ease;
  }
  .header__nav-link:hover {
    color: var(--fg);
    background-color: var(--bg-muted);
  }
  .header__nav-link[data-active="true"] {
    color: var(--fg);
    background-color: var(--bg-muted);
  }
  .header__tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }
  .header__search {
    width: 8rem;
    min-width: 0;
  }
  @media (width >= 26rem) {
    .header__search {
      width: 11rem;
    }
  }
  @media (width >= 40rem) {
    .header__search {
      width: 16rem;
    }
  }
  @media (width >= 64rem) {
    .header__search {
      width: 19rem;
    }
  }
  .header__search :global(button) {
    width: 100%;
  }
  .header__icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background-color: var(--bg);
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      color 0.14s ease,
      border-color 0.14s ease;
  }
  .header__icon-btn:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 90;
  }
  .drawer__scrim {
    position: absolute;
    inset: 0;
    background-color: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }
  .drawer__panel {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: min(20rem, 86vw);
    background-color: var(--bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    animation: slide-in 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slide-in {
    from {
      transform: translateX(-100%);
    }
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .drawer__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
  }
  .drawer__body {
    min-height: 0;
    flex: 1;
  }
</style>
