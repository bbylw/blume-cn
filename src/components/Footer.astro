---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const year = new Date().getFullYear();

const columns = [
  {
    title: "文档",
    links: [
      { label: "快速开始", href: "/docs/quickstart" },
      { label: "配置参考", href: "/docs/configuration" },
      { label: "内容组件", href: "/docs/content/components" },
      { label: "命令行", href: "/docs/cli" },
      { label: "常见问题", href: "/docs/faq" },
    ],
  },
  {
    title: "进阶",
    links: [
      { label: "内容来源", href: "/docs/content/sources/custom" },
      { label: "国际", href: "/docs/content/i18n" },
      { label: "版本控制", href: "/docs/content/versioning" },
      { label: "MCP 服务器", href: "/docs/discoverability/mcp" },
      { label: "API 参考", href: "/docs/references/openapi" },
    ],
  },
  {
    title: "生态",
    links: [
      { label: "英文官网", href: "https://useblume.dev" },
      { label: "llms.txt", href: "/llms.txt" },
      { label: "全量语料", href: "/llms-full.txt" },
      { label: "RSS 订阅", href: "/rss.xml" },
      { label: "GitHub", href: "https://github.com/haydenbleasel/blume" },
    ],
  },
];
---

<footer class:list={["footer", className]}>
  <div class="footer__inner">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3c.4 2.6-.9 4-2.2 5.3C8.2 10 6.6 11.6 6.6 14a5.4 5.4 0 0 0 10.8 0c0-1.5-.5-2.7-1.3-3.9" />
        </svg>
      </span>
      <p class="footer__pitch">
        <strong>Blume</strong> —— 面向人类与智能体的开源文档框架。快速、AI 就绪、零配置，永久免费。
      </p>
    </div>

    {
      columns.map((col) => (
        <div class="footer__col">
          <p class="footer__col-title">{col.title}</p>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="footer__bottom">
    <p>© {year} Blume 中文文档 · 遵循 MIT 许可证</p>
    <p class="footer__meta">
      本页为社区翻译，英文原文为 <a href="https://useblume.dev/docs" target="_blank" rel="noreferrer noopener">useblume.dev</a>。
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background-color: var(--bg-subtle);
    margin-top: 4rem;
  }
  .footer__inner {
    display: grid;
    gap: 2rem;
    padding: 2.75rem 1.25rem;
    max-width: 96rem;
    margin-inline: auto;
    grid-template-columns: 1fr;
  }
  @media (width >= 40rem) {
    .footer__inner {
      grid-template-columns: repeat(3, 1fr);
      padding-inline: 2rem;
    }
  }
  @media (width >= 64rem) {
    .footer__inner {
      grid-template-columns: 1.6fr repeat(3, 1fr);
    }
  }
  @media (width >= 80rem) {
    .footer__inner {
      padding-inline: 2.5rem;
    }
  }
  .footer__brand {
    max-width: 22rem;
  }
  .footer__mark {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 0.5rem;
    background: linear-gradient(140deg, var(--color-brand-400), var(--color-brand-600));
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .footer__pitch {
    font-size: 0.84375rem;
    line-height: 1.8;
    color: var(--fg-muted);
    margin: 0;
  }
  .footer__pitch strong {
    color: var(--fg);
  }
  .footer__col-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--fg-subtle);
    margin-bottom: 0.75rem;
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer__col a {
    font-size: 0.84375rem;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .footer__col a:hover {
    color: var(--accent);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding: 1.125rem 1.25rem 1.75rem;
    border-top: 1px solid var(--border);
    max-width: 96rem;
    margin-inline: auto;
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  @media (width >= 40rem) {
    .footer__bottom {
      padding-inline: 2rem;
    }
  }
  @media (width >= 80rem) {
    .footer__bottom {
      padding-inline: 2.5rem;
    }
  }
  .footer__bottom a {
    color: var(--fg-muted);
  }
</style>
