---
import katex from "katex";
// KaTeX 样式随组件按需打包：只有渲染了公式的页面才会加载这份 CSS
import "katex/dist/katex.min.css";

interface Props {
  value: string;
}

const { value } = Astro.props;
const html = katex.renderToString(value, { displayMode: false, throwOnError: false, output: "html" });
---

<span class="math-inline" set:html={html} />
