---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["diff", className]}>
  <slot />
</div>

<style>
  .diff {
    margin-block: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .diff :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .diff :global(td) {
    padding: 0.1rem 0.75rem;
    vertical-align: top;
    white-space: pre-wrap;
  }
  .diff :global(.diff-add) {
    background-color: rgb(34 197 94 / 0.12);
    color: var(--fg);
  }
  .diff :global(.diff-add td:first-child) {
    color: #16a34a;
    user-select: none;
    width: 1%;
  }
  .dark .diff :global(.diff-add td:first-child) {
    color: #4ade80;
  }
  .diff :global(.diff-remove) {
    background-color: rgb(239 68 68 / 0.12);
    color: var(--fg);
  }
  .diff :global(.diff-remove td:first-child) {
    color: #dc2626;
    user-select: none;
    width: 1%;
  }
  .dark .diff :global(.diff-remove td:first-child) {
    color: #f87171;
  }
  .diff :global(.diff-gutter) {
    background-color: var(--bg-muted);
    color: var(--fg-subtle);
    user-select: none;
    width: 1%;
    text-align: right;
  }
</style>
