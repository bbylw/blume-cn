---
interface Props {
  title?: string;
  type?: "h3" | "h4";
  icon?: string;
  class?: string;
}

const { title, type = "h3", icon, class: className = "" } = Astro.props;
const Heading = type;
---

<div class:list={["step", className]}>
  <div class="step__gutter">
    <span class="step__marker" aria-hidden="true">{icon}</span>
    <span class="step__line" aria-hidden="true"></span>
  </div>
  <div class="step__body">
    {title && <Heading class="step__title">{title}</Heading>}
    <slot />
  </div>
</div>

<style>
  .step {
    display: grid;
    grid-template-columns: 1.875rem minmax(0, 1fr);
    gap: 0.875rem;
  }
  .step__gutter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.1rem;
  }
  .step__marker {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    flex: none;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    background-color: var(--bg);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--fg-muted);
  }
  .step__line {
    flex: 1;
    width: 1px;
    min-height: 1rem;
    background: linear-gradient(to bottom, var(--border), transparent);
  }
  .step:last-child .step__line {
    display: none;
  }
  .step__body {
    padding-bottom: 1.5rem;
    min-width: 0;
  }
  .step__body :global(> :first-child) {
    margin-top: 0.15rem;
  }
  .step__body :global(> :last-child) {
    margin-bottom: 0;
  }
  .step__title {
    font-size: 1rem;
    font-weight: 650;
    color: var(--fg);
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
  }
</style>
