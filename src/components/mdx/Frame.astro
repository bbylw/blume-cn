---
interface Props {
  caption?: string;
  hint?: string;
  class?: string;
}

const { caption, hint, class: className = "" } = Astro.props;
---

<figure class:list={["frame", className]}>
  <div class="frame__body">
    <slot />
  </div>
  {caption && <figcaption class="frame__caption">{caption}</figcaption>}
  {hint && <p class="frame__hint">{hint}</p>}
</figure>

<style>
  .frame {
    margin-block: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    background-color: var(--bg-subtle);
    padding: 1.25rem;
  }
  .frame__body {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .frame__body :global(img),
  .frame__body :global(video),
  .frame__body :global(svg) {
    max-width: 100%;
    border-radius: 0.5rem;
  }
  .frame__caption {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    text-align: center;
  }
  .frame__hint {
    font-size: 0.75rem;
    color: var(--fg-subtle);
    text-align: center;
    margin: 0;
  }
</style>
