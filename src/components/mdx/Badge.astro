---
interface Props {
  variant?: "default" | "info" | "success" | "warning" | "danger" | "accent";
  size?: "sm" | "md";
  class?: string;
}

const { variant = "default", size = "md", class: className = "" } = Astro.props;

const styles: Record<string, string> = {
  default: "border-line text-fg-muted bg-bg-muted",
  info: "border-sky-300/60 text-sky-700 bg-sky-50 dark:border-sky-500/25 dark:text-sky-300 dark:bg-sky-500/10",
  success:
    "border-emerald-300/60 text-emerald-700 bg-emerald-50 dark:border-emerald-500/25 dark:text-emerald-300 dark:bg-emerald-500/10",
  warning:
    "border-amber-300/70 text-amber-700 bg-amber-50 dark:border-amber-500/25 dark:text-amber-300 dark:bg-amber-500/10",
  danger:
    "border-rose-300/70 text-rose-700 bg-rose-50 dark:border-rose-500/25 dark:text-rose-300 dark:bg-rose-500/10",
  accent: "border-brand-200 text-brand-700 bg-brand-50 dark:border-brand-500/30 dark:text-brand-300 dark:bg-brand-500/10",
};
---

<span class:list={["badge", styles[variant] ?? styles.default, size === "sm" ? "badge--sm" : "", className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: 1px solid;
    border-radius: 9999px;
    padding: 0.1rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: 0.01em;
    white-space: nowrap;
    vertical-align: middle;
  }
  .badge--sm {
    font-size: 0.6875rem;
    padding: 0 0.4rem;
  }
</style>
