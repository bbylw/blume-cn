---
interface Field {
  type?: string;
  required?: boolean;
  default?: string;
  description?: string;
}

interface Props {
  type: Record<string, Field>;
  class?: string;
}

const { type, class: className = "" } = Astro.props;
const entries = Object.entries(type ?? {});
---

<div class:list={["type-table-wrap", className]}>
  <table class="type-table">
    <thead>
      <tr>
        <th>名称</th>
        <th>类型</th>
        <th>必填</th>
        <th>默认值</th>
        <th>说明</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map(([name, field]) => (
          <tr>
            <td><code class="tt-name">{name}</code></td>
            <td><code class="tt-type">{field.type ?? "—"}</code></td>
            <td>{field.required ? <span class="tt-req">必填</span> : <span class="tt-opt">可选</span>}</td>
            <td>{field.default ? <code class="tt-type">{field.default}</code> : <span class="tt-opt">—</span>}</td>
            <td class="tt-desc">{field.description ?? ""}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .type-table-wrap {
    margin-block: 1.75rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
  }
  .type-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .type-table th {
    text-align: left;
    font-weight: 650;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    padding: 0.625rem 0.875rem;
    background-color: var(--bg-muted);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .type-table td {
    padding: 0.7rem 0.875rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .type-table tr:last-child td {
    border-bottom: 0;
  }
  code.tt-name {
    font-family: var(--font-mono);
    font-weight: 620;
    color: var(--fg);
    font-size: 0.8125rem;
  }
  code.tt-type {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.75rem;
    word-break: break-word;
  }
  .tt-req {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .tt-opt {
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .tt-desc {
    color: var(--fg-muted);
    line-height: 1.7;
    min-width: 14rem;
  }
</style>
