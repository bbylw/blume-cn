---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = "" } = Astro.props;
---

<details class:list={["expandable", className]}>
  <summary>
    <span class="expandable__title">{title ?? "展开查看"}</span>
    <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m4 6 4 4 4-4"></path>
    </svg>
  </summary>
  <div class="expandable__body">
    <slot />
  </div>
</details>

<style>
  .expandable {
    margin-block: 1.5rem;
    border: 1px dashed var(--border-strong);
    border-radius: 0.75rem;
    background-color: var(--bg-subtle);
  }
  .expandable summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    padding: 0.6rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 620;
    color: var(--fg-muted);
  }
  .expandable summary::-webkit-details-marker {
    display: none;
  }
  .expandable summary:hover {
    color: var(--accent);
  }
  .expandable[open] summary svg {
    transform: rotate(180deg);
  }
  .expandable summary svg {
    transition: transform 0.2s ease;
  }
  .expandable__body {
    padding: 0 0.875rem 0.875rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .expandable__body :global(> :first-child) {
    margin-top: 0;
  }
  .expandable__body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
