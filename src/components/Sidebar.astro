---
import { navGroups } from "../lib/nav";

interface Props {
  pathname: string;
  /** 移动端抽屉 */
  variant?: "desktop" | "mobile";
}

const { pathname, variant = "desktop" } = Astro.props;

const clean = pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => clean === href;

const groups = navGroups.map((group, index) => ({
  ...group,
  active: group.items.some((i) => isActive(i.href)),
  fallbackOpen: index === 0,
}));

// 页面在导航之外时，默认展开第一个分组，避免侧边栏看起来是空的
const anyActive = groups.some((g) => g.active);
---

<nav class:list={["sidebar", variant === "mobile" && "sidebar--mobile"]} aria-label="文档导航">
  <div class="sidebar__scroll">
    {
      groups.map((group) => (
        <details class="sidebar__group" open={anyActive ? group.active : group.fallbackOpen}>
          <summary class="sidebar__group-title">
            <span>{group.title}</span>
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m4 6 4 4 4-4" />
            </svg>
          </summary>
          <ul class="sidebar__list">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="sidebar__link"
                  data-active={isActive(item.href)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.title}
                  {item.badge && <span class="sidebar__badge">{item.badge}</span>}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
</nav>

<style>
  .sidebar {
    height: 100%;
    min-height: 0;
  }
  .sidebar__scroll {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.5rem 0.75rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sidebar__group {
    border-radius: 0.5rem;
  }
  .sidebar__group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    color: var(--fg-subtle);
    transition:
      color 0.14s ease,
      background-color 0.14s ease;
  }
  .sidebar__group-title::-webkit-details-marker {
    display: none;
  }
  .sidebar__group-title:hover {
    color: var(--fg);
    background-color: var(--bg-muted);
  }
  .sidebar__group-title svg {
    transition: transform 0.18s ease;
    opacity: 0.6;
  }
  .sidebar__group[open] .sidebar__group-title svg {
    transform: rotate(180deg);
  }
  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
  }
  .sidebar__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--fg-muted);
    text-decoration: none;
    transition:
      color 0.14s ease,
      background-color 0.14s ease;
  }
  .sidebar__link:hover {
    color: var(--fg);
    background-color: var(--bg-muted);
  }
  .sidebar__link[data-active="true"] {
    color: var(--accent);
    background-color: var(--accent-soft);
    font-weight: 620;
  }
  .sidebar__link[data-active="true"]::before {
    content: "";
    position: absolute;
    left: -0.75rem;
    top: 50%;
    translate: 0 -50%;
    width: 2px;
    height: 1.125rem;
    border-radius: 9999px;
    background-color: var(--accent);
  }
  .sidebar__badge {
    margin-left: auto;
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0 0.375rem;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    color: var(--fg-subtle);
  }
</style>
