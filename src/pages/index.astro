---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { navGroups } from "../lib/nav";

const install = "npx blume init";

const pillars = [
  {
    tag: "默认即快速",
    title: "Astro + Vite 的静态 HTML",
    body: "核心主题不携带任何客户端框架 JS，页面开箱即可取得良好的 Core Web Vitals 评分。开发启动与热重载保持 Vite 原生手感，只有需要时才开启服务端特性。",
    href: "/docs",
  },
  {
    tag: "AI 就绪",
    title: "你的 Markdown 同时喂饱人类与模型",
    body: "自动产出 llms.txt 与 llms-full.txt，任意 .md URL 返回原始 Markdown，附带 JSON API、复制为 Markdown、打开聊天，以及一个托管的 MCP 服务器。",
    href: "/docs/discoverability",
  },
  {
    tag: "零配置",
    title: "一个文档文件夹就是完整项目",
    body: "无需克隆起始模板，无需搭建 Astro 与 Tailwind，无需维护模板。导航从文件推导，搜索在开发与生产都能跑，主题只是几个令牌。",
    href: "/docs/quickstart",
  },
  {
    tag: "类型安全",
    title: "配置是真正的 TypeScript",
    body: "blume.config.ts 与每一个 meta.ts 都经过 schema 校验，编辑器在构建之前就能发现拼写错误、非法取值与缺失字段。",
    href: "/docs/configuration",
  },
];

const features = [
  { title: "组件，无需导入", body: "卡片、分栏、步骤、标签页、手风琴、徽章、代码组、文件树、类型表、实时预览、差异对比，在任意 MDX 页面直接用。", href: "/docs/content/components" },
  { title: "本地搜索", body: "Orama 在开发与生产环境均运行，不需要任何托管服务；Pagefind、FlexSearch、Algolia、Typesense 只差一个适配器。", href: "/docs/configuration/search" },
  { title: "内容来源", body: "本地文件与远程 MDX、GitHub Releases、Notion、Sanity、Contentful、Payload、Strapi 或任意自定义后端混进同一个站点。", href: "/docs/content/sources/custom" },
  { title: "国际化", body: "把翻译好的文件就位，即可获得感知语言区域的路由、按语言划分的导航、翻译后的界面与 SEO。", href: "/docs/content/i18n" },
  { title: "SEO 与社交卡片", body: "元信息、构建期渲染的 Open Graph 图片、站点地图、robots.txt、RSS 订阅源与 JSON-LD，全部内置。", href: "/docs/discoverability" },
  { title: "API 参考", body: "用 openapi()、asyncapi()、graphql() 把规范渲染成原生参考页面，每个操作一页，含 schema、鉴权与请求演练场。", href: "/docs/references/openapi" },
  { title: "导出", body: "让读者把任意页面下载为 PDF 或 EPUB，完全在客户端完成，因此静态构建依然保持静态。", href: "/docs/configuration/export" },
  { title: "完全自定义", body: "组件覆盖、React 孤岛、自定义页面、Tailwind v4 主题令牌，以及源组件注册表（blume add）。", href: "/docs/configuration/customization" },
];

const commands = [
  ["blume init [dir]", "搭建项目（默认交互式）"],
  ["blume dev", "启动带热重载的开发服务器"],
  ["blume build", "构建静态（或服务端）站点"],
  ["blume preview", "预览上一次构建的结果"],
  ["blume add <item>", "从注册表安装一个源组件"],
  ["blume sync", "重新拉取远程内容来源并重新生成"],
  ["blume eject", "将运行时提升为独立的 Astro 应用"],
  ["blume check", "用 astro check 对文档站点做类型检查"],
  ["blume validate", "校验内部链接、锚点、资源与外部链接"],
  ["blume doctor", "诊断配置与内容问题"],
  ["blume audit", "审计已构建站点在 SEO 与健康度方面的问题"],
  ["blume eval", "由智能体仅依据文档回答你的问题"],
  ["blume translate", "用本地智能体 CLI 翻译成已配置的语言区域"],
  ["blume version [id]", "把当前文档冻结为一个归档版本"],
  ["blume migrate [source]", "借助 Claude Code 或 Codex 迁移到 Blume"],
  ["blume upgrade", "升级到新的大版本"],
];

const adapters = [
  ["vercel()", "Vercel"],
  ["netlify()", "Netlify Functions"],
  ["node()", "自托管的 Node 服务器、容器"],
  ["cloudflare()", "Cloudflare Workers 与 Pages"],
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Blume 中文文档",
      url: new URL("/", Astro.site ?? "https://blume.ndjp.net").href,
      inLanguage: "zh-CN",
      description: "面向人类与智能体的开源文档框架 —— 快速、AI 就绪、零配置。",
    },
    {
      "@type": "SoftwareApplication",
      name: "Blume",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "跨平台",
      description: "构建在 Astro 与 Vite 之上的开源文档框架。",
      license: "https://opensource.org/licenses/MIT",
      codeRepository: "https://github.com/haydenbleasel/blume",
    },
  ],
};
---

<BaseLayout
  title="Blume 中文文档 —— 面向人类与智能体的开源文档框架"
  description="Blume 是一个开源、以 Markdown 为先的文档框架，构建在 Astro 与 Vite 之上：快速、AI 就绪、零配置到连模板都不需要。快速开始只需 npx blume init。"
  jsonLd={jsonLd}
  class="overflow-x-clip"
>
  <main>
    <!-- ============ Hero ============ -->
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="hero__inner">
        <p class="hero__pill">
          <span class="hero__pill-dot"></span>
          Markdown 优先 · 构建于 Astro 与 Vite
        </p>

        <h1 class="hero__title">
          面向人类与<br class="sm:hidden" />
          <span class="hero__title-accent">智能体</span>的开源文档框架
        </h1>

        <p class="hero__lede">
          把 Markdown 或 MDX 文件丢进文件夹，启动开发服务器，就能得到一个生产级的文档站点 —— 导航、搜索、主题、Open Graph
          图片，以及一整套组件库。无需编写或维护任何应用样板。
        </p>

        <div class="hero__actions">
          <a href="/docs/quickstart" class="btn btn--primary">
            快速开始
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" />
            </svg>
          </a>
          <a href="/docs" class="btn btn--ghost">阅读文档</a>
          <a href="https://useblume.dev" target="_blank" rel="noreferrer noopener" class="btn btn--ghost">
            英文官网
            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3.5h6.5V10M12.5 3.5 4.5 11.5" />
            </svg>
          </a>
        </div>

        <div class="terminal" data-terminal>
          <div class="terminal__bar">
            <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="terminal__label">终端</span>
            <button type="button" class="terminal__copy" data-copy={install} aria-label="复制命令">
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
                <path d="M10.5 5.5v-1a1.5 1.5 0 0 0-1.5-1.5H4a1.5 1.5 0 0 0-1.5 1.5V9A1.5 1.5 0 0 0 4 10.5h1"></path>
              </svg>
            </button>
          </div>
          <pre class="terminal__body"><code><span class="terminal__prompt">$</span> npx blume init
<span class="terminal__dim">  正在生成 docs/index.mdx 与 blume.config.ts …</span>
<span class="terminal__ok">✓</span> 就绪，运行 <span class="terminal__cmd">npm run dev</span></code></pre>
        </div>

        <ul class="hero__stats">
          <li><strong>0</strong><span>需要配置的样板文件</span></li>
          <li><strong>0 KB</strong><span>核心主题的客户端框架 JS</span></li>
          <li><strong>63</strong><span>中文文档页面</span></li>
          <li><strong>MIT</strong><span>永久免费且开源</span></li>
        </ul>
      </div>
    </section>

    <!-- ============ 四根支柱 ============ -->
    <section class="section">
      <div class="section__head">
        <p class="section__eyebrow">为什么选择 Blume</p>
        <h2 class="section__title">框架本身就是模板</h2>
        <p class="section__lede">
          一些文档工具在你写下第一个字之前就先塞给你一整份代码库。另一些围绕你的内容搭建模板，却把你锁死在它们的托管服务里。Blume
          两者都取：你唯一需要碰的就是内容本身。
        </p>
      </div>

      <div class="pillars">
        {
          pillars.map((p) => (
            <a class="pillar" href={p.href}>
              <span class="pillar__tag">{p.tag}</span>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__body">{p.body}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ============ 工作原理 ============ -->
    <section class="section">
      <div class="how">
        <div class="how__col">
          <p class="section__eyebrow">工作原理</p>
          <h2 class="section__title">一个文件夹，就是一个完整项目</h2>
          <p class="section__lede">
            Blume 命令行加载 <code>blume.config.ts</code>，把内容扫描成一张图，并在 <code>.blume/</code> 下生成一个隐藏的 Astro
            项目，由它在开发与构建时驱动。
          </p>
          <p class="section__lede">
            这个运行时是实现细节 —— 你写 Markdown，剩下的交给 Blume —— 直到你执行 <code>blume eject</code> 并亲手接管它。
          </p>
          <a class="text-link" href="/docs/configuration/customization">
            了解自定义与 eject
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8h9m0 0-3.5-3.5M12 8l-3.5 3.5" />
            </svg>
          </a>
        </div>

        <div class="how__col">
          <div class="filecard">
            <div class="filecard__head">
              <span class="filecard__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="filecard__label">你的项目</span>
            </div>
            <ul class="filecard__body">
              <li><b>docs/</b></li>
              <li class="is-nested"><b>index.mdx</b></li>
              <li class="is-nested"><b>quickstart.md</b></li>
              <li class="is-nested"><b>content/</b></li>
              <li class="is-nested is-nested2"><b>components.mdx</b></li>
              <li><b>blume.config.ts</b></li>
              <li><b>package.json</b></li>
            </ul>
            <div class="filecard__arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2.5v11m0 0 4-4m-4 4-4-4" />
              </svg>
            </div>
            <ul class="filecard__body filecard__body--out">
              <li class="is-out">导航</li>
              <li class="is-out">本地搜索索引</li>
              <li class="is-out">主题与 OG 图片</li>
              <li class="is-out">llms.txt / MCP</li>
              <li class="is-out">站点地图与 RSS</li>
              <li class="is-out is-strong">dist/ 静态站点</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 特性 ============ -->
    <section class="section">
      <div class="section__head">
        <p class="section__eyebrow">开箱即用</p>
        <h2 class="section__title">特性</h2>
        <p class="section__lede">一个文档文件夹就是一个完整的项目。每一项都有合理的默认值，配置是你伸手去取的东西，而不是你的起点。</p>
      </div>
      <div class="features">
        {
          features.map((f) => (
            <a class="feature" href={f.href}>
              <h3 class="feature__title">{f.title}</h3>
              <p class="feature__body">{f.body}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ============ 命令行 ============ -->
    <section class="section">
      <div class="cli">
        <div class="cli__head">
          <p class="section__eyebrow">命令行</p>
          <h2 class="section__title">全部命令，一处查完</h2>
          <p class="section__lede">通过包管理器运行 <code>npx blume &lt;命令&gt;</code>，或写进 <code>package.json</code> 脚本。</p>
        </div>
        <div class="cli__table-wrap">
          <table class="cli__table">
            <thead>
              <tr><th>命令</th><th>说明</th></tr>
            </thead>
            <tbody>
              {commands.map(([cmd, desc]) => (
                <tr>
                  <td><code>{cmd}</code></td>
                  <td>{desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============ 部署与兼容 ============ -->
    <section class="section">
      <div class="deploy">
        <div class="deploy__col">
          <p class="section__eyebrow">部署</p>
          <h2 class="section__title section__title--sm">blume build 产出静态 HTML</h2>
          <p class="section__lede">
            输出到 <code>dist/</code>，可部署到任意静态托管：Vercel、Netlify、Cloudflare Pages、GitHub Pages、S3 + CloudFront
            或任意 CDN。需要请求期特性（助手、MCP 服务器）时，在配置里指定托管适配器即可切换为服务端输出。
          </p>
          <pre class="deploy__code"><code>{`import { defineConfig } from "blume";
import { vercel } from "blume/deploy";

export default defineConfig({
  deployment: vercel(),
});`}</code></pre>
        </div>

        <div class="deploy__col">
          <div class="panel">
            <p class="panel__title">托管适配器</p>
            <ul class="panel__list">
              {
                adapters.map(([fn, target]) => (
                  <li>
                    <code>{fn}</code>
                    <span>{target}</span>
                  </li>
                ))
              }
            </ul>
            <p class="panel__note">适配器永远不会被自动探测，必须在 <code>blume.config.ts</code> 中显式指定。</p>
          </div>

          <div class="panel">
            <p class="panel__title">兼容性</p>
            <ul class="panel__list">
              <li><code>Node</code><span>22.12+</span></li>
              <li><code>包管理器</code><span>Bun、pnpm、npm、yarn</span></li>
              <li><code>适配器</code><span>Vercel、Netlify、Node、Cloudflare</span></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 文档地图 ============ -->
    <section class="section">
      <div class="section__head">
        <p class="section__eyebrow">文档</p>
        <h2 class="section__title">从这里开始读</h2>
      </div>
      <div class="map">
        {
          navGroups.map((group) => (
            <section class="map__group">
              <h3 class="map__group-title">{group.title}</h3>
              <p class="map__group-desc">{group.description}</p>
              <ul class="map__list">
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <!-- ============ 结尾 CTA ============ -->
    <section class="section">
      <div class="cta">
        <h2 class="cta__title">把 Markdown 丢进去，站点就出来了</h2>
        <p class="cta__lede">需要 Node.js 22.12 或更高版本，以及一个至少包含一个 .md 或 .mdx 文件的内容文件夹。除此之外没有任何需要配置的东西。</p>
        <div class="cta__actions">
          <a href="/docs/quickstart" class="btn btn--primary">开始使用</a>
          <a href="/docs/migrating" class="btn btn--ghost">从别的框架迁移</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement | null;
    const btn = target?.closest<HTMLElement>("[data-copy]");
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.copy ?? "");
      btn.classList.add("is-copied");
      setTimeout(() => btn.classList.remove("is-copied"), 1600);
    } catch {
      /* 剪贴板不可用 */
    }
  });
</script>

<style>
  /* ================= Hero ================= */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 78%);
  }
  .hero__glow {
    position: absolute;
    top: -18rem;
    left: 50%;
    translate: -50% 0;
    width: 62rem;
    height: 40rem;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, var(--color-brand-400) 26%, transparent),
      transparent 68%
    );
    filter: blur(30px);
  }
  .hero__inner {
    position: relative;
    max-width: 72rem;
    margin-inline: auto;
    padding: 5rem 1.25rem 4rem;
    text-align: center;
  }
  @media (width >= 48rem) {
    .hero__inner {
      padding: 6.5rem 2rem 5rem;
    }
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--bg) 70%, transparent);
    padding: 0.3rem 0.85rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
  .hero__pill-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background-color: var(--color-brand-500);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-500) 22%, transparent);
  }
  .hero__title {
    margin: 1.5rem 0 0;
    font-size: clamp(2.25rem, 6.2vw, 4rem);
    line-height: 1.14;
    font-weight: 720;
    letter-spacing: -0.035em;
    color: var(--fg);
    text-wrap: balance;
  }
  .hero__title-accent {
    background-image: linear-gradient(100deg, var(--color-brand-500), var(--color-brand-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lede {
    max-width: 42rem;
    margin: 1.5rem auto 0;
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  @media (width >= 48rem) {
    .hero__lede {
      font-size: 1.125rem;
    }
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.625rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 0.625rem;
    padding: 0.6rem 1.05rem;
    font-size: 0.90625rem;
    font-weight: 620;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease,
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .btn--primary {
    background-color: var(--color-brand-600);
    color: #fff;
    box-shadow: 0 8px 20px -10px color-mix(in oklab, var(--color-brand-600) 80%, transparent);
  }
  .btn--primary:hover {
    background-color: var(--color-brand-500);
    transform: translateY(-1px);
  }
  .btn--ghost {
    border-color: var(--border);
    background-color: var(--bg);
    color: var(--fg-muted);
  }
  .btn--ghost:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .terminal {
    max-width: 30rem;
    margin: 3rem auto 0;
    border: 1px solid var(--border);
    border-radius: 0.875rem;
    overflow: hidden;
    background-color: var(--bg);
    box-shadow: 0 24px 60px -32px rgb(0 0 0 / 0.45);
    text-align: left;
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.5rem 0.45rem 0.875rem;
    border-bottom: 1px solid var(--border);
