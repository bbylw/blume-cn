---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const popular = [
  { label: "快速开始", href: "/docs/quickstart/" },
  { label: "文档总览", href: "/docs/" },
  { label: "内容组件", href: "/docs/content/components/" },
  { label: "命令行", href: "/docs/cli/" },
  { label: "常见问题", href: "/docs/faq/" },
];
---

<BaseLayout
  title="页面不存在"
  description="你要找的页面不存在或已被移动。试试搜索文档，或从下面的常用页面重新进入。"
  noindex
  markdownAlternate={false}
>
  <Header pathname="/404" />

  <main id="main" tabindex="-1" class="notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="notfound__title">这个页面走丢了</h1>
    <p class="notfound__text">
      链接可能过期，页面可能被移动或改名。用右上角的搜索找一下，或者从常用页面重新进入。
    </p>
    <div class="notfound__actions">
      <a href="/" class="notfound__btn notfound__btn--primary">回首页</a>
      <a href="/docs/" class="notfound__btn">阅读文档</a>
    </div>
    <nav class="notfound__popular" aria-label="常用页面">
      {
        popular.map((p) => (
          <a href={p.href} class="notfound__link">
            {p.label}
          </a>
        ))
      }
    </nav>
  </main>

  <Footer />
</BaseLayout>

<style>
  .notfound {
    max-width: 42rem;
    margin-inline: auto;
    padding: 5rem 1.25rem 6rem;
    text-align: center;
  }
  .notfound__code {
    margin: 0;
    font-size: clamp(4rem, 14vw, 7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(140deg, var(--color-brand-400), var(--color-brand-600));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .notfound__title {
    margin: 1rem 0 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--fg);
  }
  .notfound__text {
    margin: 0.75rem auto 0;
    max-width: 30rem;
    color: var(--fg-muted);
    line-height: 1.75;
  }
  .notfound__actions {
    margin-top: 1.75rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .notfound__btn {
    display: inline-block;
    padding: 0.625rem 1.375rem;
    border-radius: 0.625rem;
    border: 1px solid var(--border);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
    background-color: var(--bg-subtle);
  }
  .notfound__btn:hover {
    border-color: var(--border-strong);
  }
  .notfound__btn--primary {
    border-color: transparent;
    color: #fff;
    background: linear-gradient(140deg, var(--color-brand-400), var(--color-brand-600));
  }
  .notfound__popular {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 0.5rem 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .notfound__link {
    font-size: 0.875rem;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .notfound__link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
