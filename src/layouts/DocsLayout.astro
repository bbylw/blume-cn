---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import Footer from "../components/Footer.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface PageLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  headings: Heading[];
  group?: string;
  prev?: PageLink;
  next?: PageLink;
  updated?: Date;
  noindex?: boolean;
}

const { title, description, headings, group, prev, next, updated, noindex } = Astro.props;
const pathname = Astro.url.pathname;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  inLanguage: "zh-CN",
  isPartOf: {
    "@type": "WebSite",
    name: "Blume 中文文档",
    url: new URL("/", Astro.site ?? "https://blume.ndjp.net").href,
  },
  dateModified: updated?.toISOString(),
};
---

<BaseLayout title={title} description={description} noindex={noindex} type="article" jsonLd={jsonLd}>
  <Header pathname={pathname} />

  <div class="shell">
    <aside class="shell__side">
      <div class="shell__side-inner">
        <Sidebar pathname={pathname} />
      </div>
    </aside>

    <main class="shell__main" id="main" tabindex="-1">
      <div class="shell__main-inner">
        {group && <p class="eyebrow">{group}</p>}
        <h1 class="title">{title}</h1>
        {description && <p class="lede">{description}</p>}

        <div class="rule" role="presentation"></div>

        <article class="prose-docs prose prose-zh max-w-none">
          <slot />
        </article>

        <div class="pager">
          {
            prev ? (
              <a class="pager__card" href={prev.href}>
                <span class="pager__dir">← 上一页</span>
                <span class="pager__title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="pager__card pager__card--next" href={next.href}>
                <span class="pager__dir">下一页 →</span>
                <span class="pager__title">{next.title}</span>
              </a>
            )
          }
        </div>
      </div>
    </main>

    <aside class="shell__rail">
      <div class="shell__rail-inner">
        <TableOfContents headings={headings} />
        <a class="rail-cta" href="/docs/quickstart/">
          <span class="rail-cta__label">快速开始</span>
          <span class="rail-cta__text">几分钟搭好第一个站点 →</span>
        </a>
      </div>
    </aside>
  </div>

  <Footer />
</BaseLayout>

<style>
  .shell {
    display: grid;
    /* minmax(0,…) 避免表格/代码块把整列撑宽 */
    grid-template-columns: minmax(0, 1fr);
    max-width: 96rem;
    margin-inline: auto;
  }
  @media (width >= 64rem) {
    .shell {
      grid-template-columns: 15.5rem minmax(0, 1fr);
    }
  }
  @media (width >= 80rem) {
    .shell {
      grid-template-columns: 16.5rem minmax(0, 1fr) 14rem;
    }
  }
  .shell__side {
    display: none;
    border-right: 1px solid var(--border);
  }
  @media (width >= 64rem) {
    .shell__side {
      display: block;
    }
  }
  .shell__side-inner {
    position: sticky;
    top: 3.75rem;
    height: calc(100vh - 3.75rem);
  }
  .shell__main-inner {
    padding: 2rem 1.25rem 1rem;
    min-width: 0;
  }
  @media (width >= 48rem) {
    .shell__main-inner {
      padding: 3rem 2.5rem 1rem;
    }
  }
  @media (width >= 80rem) {
    .shell__main-inner {
      padding: 3.25rem 3.25rem 1rem;
    }
  }
  .shell__rail {
    display: none;
  }
  @media (width >= 80rem) {
    .shell__rail {
      display: block;
      border-left: 1px solid var(--border);
    }
  }
  .shell__rail-inner {
    position: sticky;
    top: 3.75rem;
    padding: 3.25rem 1.25rem 3rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 0.625rem;
  }
  .title {
    font-size: 1.75rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--fg);
    margin: 0;
    text-wrap: balance;
  }
  @media (width >= 48rem) {
    .title {
      font-size: 2.375rem;
    }
  }
  .lede {
    margin-top: 0.75rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--fg-muted);
    text-wrap: pretty;
  }
  @media (width >= 48rem) {
    .lede {
      font-size: 1.0625rem;
    }
  }
  .rule {
    height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
    margin-block: 2rem 0.5rem;
  }

  .pager {
    display: grid;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  @media (width >= 40rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pager__card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    text-decoration: none;
    transition:
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .pager__card:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    background-color: var(--bg-subtle);
  }
  .pager__card--next {
    text-align: right;
  }
  .pager__dir {
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .pager__title {
    font-size: 0.9375rem;
    font-weight: 620;
    color: var(--fg);
  }

  .rail-cta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 0.75rem 0.875rem;
    text-decoration: none;
    background-color: var(--bg-subtle);
  }
  .rail-cta:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
  }
  .rail-cta__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .rail-cta__text {
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }
</style>
